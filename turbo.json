{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_PORT",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "DATABASE_FIXTURE_MODE",
    "VITE_API_URL",
    "WEB_URL",
    "APP_ENV",
    "EMAIL_MODE",
    "EMAIL_FROM",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "EMAIL_ALLOWED_RECIPIENTS",
    "LOG_FORMAT",
    "LOG_LEVEL",
    "LOG_FILE",
    "METRICS_ENABLED",
    "METRICS_HOST",
    "METRICS_PORT",
    "APP_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "interruptible": true,
      "persistent": true
    },
    "@workspace/api#dev": {
      "dependsOn": ["@workspace/i18n#build"],
      "cache": false,
      "interruptible": true,
      "persistent": true,
      "with": [
        "@workspace/database#dev",
        "@workspace/email#dev",
        "@workspace/i18n#dev"
      ]
    },
    "@workspace/i18n#build": {
      "outputs": ["src/generated/**"]
    },
    "@workspace/i18n#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "interruptible": true,
      "persistent": true
    },
    "@workspace/i18n#typecheck": {
      "dependsOn": ["build"]
    },
    "web#dev": {
      "dependsOn": ["@workspace/i18n#build"],
      "with": ["@workspace/i18n#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
