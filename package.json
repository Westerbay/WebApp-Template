{
  "name": "webapp-template",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "valkey:up": "node scripts/infra/stack.mjs valkey up",
    "valkey:down": "node scripts/infra/stack.mjs valkey down",
    "valkey:test": "pnpm --filter @workspace/api exec vitest run --config vitest.valkey.config.ts",
    "build": "turbo build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm api:check && pnpm docs:check && pnpm project:check && pnpm build",
    "api:check": "node scripts/api-contract.mjs check",
    "api:generate": "node scripts/api-contract.mjs generate",
    "db:generate": "turbo db:generate --filter=@workspace/database",
    "db:migrate": "turbo db:migrate --filter=@workspace/database",
    "db:seed": "turbo db:seed --filter=@workspace/api",
    "db:studio": "turbo db:studio --filter=@workspace/database",
    "dev": "turbo dev",
    "dev:down": "docker compose down",
    "dev:infra": "docker compose up -d --wait",
    "docs:check": "node scripts/docs-check.mjs",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "project:check": "pnpm tooling:test && pnpm boundaries:check && pnpm boundaries:test && node scripts/project-check.mjs",
    "boundaries:check": "depcruise --config packages/config/dependency-cruiser.mjs apps packages",
    "boundaries:test": "node --test scripts/test/boundaries.test.mjs",
    "setup": "node scripts/infra/setup.mjs",
    "tooling:test": "node --test scripts/test/infra-stack.test.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "test:integration": "node scripts/infra/test-auth.mjs integration",
    "test:e2e": "node scripts/infra/test-auth.mjs e2e",
    "template:create": "node scripts/template-create.mjs",
    "template:archives": "node scripts/template-archives.mjs",
    "template:check": "node --test scripts/test/template-*.test.mjs",
    "dev:logs": "node scripts/infra/dev-logs.mjs",
    "logs:up": "node scripts/infra/stack.mjs logs up",
    "logs:check": "node scripts/infra/check-observability.mjs",
    "logs:down": "node scripts/infra/stack.mjs logs down",
    "logs:test": "pnpm --filter @workspace/api^... build && pnpm --filter @workspace/api build && node scripts/infra/test-logs.mjs",
    "logs:preview": "pnpm --filter @workspace/api^... build && pnpm --filter @workspace/api build && node scripts/infra/test-logs.mjs --preview",
    "logs:test:docker": "node scripts/infra/test-docker-logs.mjs",
    "worktree:create": "node scripts/worktree.mjs create",
    "worktree:remove": "node scripts/worktree.mjs remove",
    "worktree:check": "node --test scripts/test/worktree.test.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.6.0",
    "fflate": "0.8.3",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12"
  }
}
