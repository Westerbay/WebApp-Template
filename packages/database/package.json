{
  "name": "@workspace/database",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.generate.config.ts",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "db:studio": "drizzle-kit studio",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.3.2",
    "@types/node": "24.5.2",
    "dotenv": "17.2.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.36.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./target": {
      "types": "./src/target.ts",
      "default": "./dist/target.js"
    }
  }
}
