    "nodemailer": "10.1.4",
    "react": "^19.2.6",
    "zod": "4.6.2",
    "@workspace/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "^19",
    "@types/nodemailer": "7.0.11",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "eslint": "9.36.0",
    "@tanstack/eslint-config": "0.3.2"
