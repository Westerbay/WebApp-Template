{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "docker-compose", "github-actions"],
  "schedule": ["* 6-10 * * 1"],
  "timezone": "Europe/Paris",
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "description": "Group compatible JavaScript dependency updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "JavaScript dependencies"
    },
    {
      "description": "Group compatible infrastructure image updates",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Docker images"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Update pnpm manually together with CI and project checks",
      "matchPackageNames": ["pnpm"],
      "enabled": false
    }
  ]
}
