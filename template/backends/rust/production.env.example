# Production example only. Copy to .env.production and replace every placeholder.
# Never commit the resulting file. The deployment platform may inject these values instead.
API_IMAGE=ghcr.io/your-org/your-app:replace-with-reviewed-tag
APP_ENV=production
API_PORT=3001
DATABASE_URL=postgresql://app:REPLACE_DATABASE_PASSWORD@db.example.com:5432/app?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://api.example.com
WEB_URL=https://app.example.com
EMAIL_MODE=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
# Required for staging only; comma-separated exact addresses.
EMAIL_ALLOWED_RECIPIENTS=
# Public frontend build-time value, not a Rust runtime secret.
VITE_API_URL=https://api.example.com
