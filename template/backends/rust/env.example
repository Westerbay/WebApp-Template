# Local PostgreSQL and Mailpit only. Copy to .env yourself before setup.
POSTGRES_DB=webapp_template_rust
POSTGRES_USER=webapp_template_rust
POSTGRES_PASSWORD=webapp_template_rust_dev
POSTGRES_PORT=5434
DATABASE_URL=postgresql://webapp_template_rust:webapp_template_rust_dev@localhost:5434/webapp_template_rust
DATABASE_FIXTURE_MODE=enabled
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
EMAIL_MODE=capture
EMAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# Staging/production: HTTPS origins, persistent secret, PostgreSQL sslmode=verify-full.
# Set EMAIL_MODE=smtp and SMTP_USER / SMTP_PASSWORD in the deployment environment.
# SMTP_SECURE=false requires STARTTLS; true uses implicit TLS.
# Staging SMTP also requires EMAIL_ALLOWED_RECIPIENTS (exact comma-separated addresses).
