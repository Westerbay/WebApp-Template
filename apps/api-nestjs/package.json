{
  "name": "@workspace/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:seed": "pnpm --filter @workspace/api^... build && pnpm build && node --env-file-if-exists=../../.env dist/cli/seed.js",
    "dev": "pnpm --filter @workspace/api^... build && tsc-watch --onSuccess \"node --env-file=../../.env dist/index.js\"",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@prometheus-io/client": "0.16.1",
    "@workspace/config": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "better-auth": "1.7.7",
    "cors": "2.8.5",
    "express": "5.3.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "5.1.0",
    "nestjs-zod": "5.5.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rou3": "0.9.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.13.5",
    "@tanstack/eslint-config": "0.3.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "drizzle-orm": "0.45.2",
    "eslint": "9.36.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.1.4",
    "tsc-watch": "7.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.5"
  }
}
